# Nomos configuration — copy to .env to override defaults.
# All values shown are the defaults; ./start.sh works with no .env at all.

# Bind address. Use 0.0.0.0 to serve beyond localhost (cloud deployment).
NOMOS_HOST=127.0.0.1
NOMOS_PORT=8484

# Directory holding nomos.db, attachments/, and logs/. Back up by copying it.
NOMOS_DATA_DIR=./data

# Maximum attachment size in megabytes.
NOMOS_MAX_UPLOAD_MB=25

# Public base URL (used in exports and docs when behind a reverse proxy).
NOMOS_BASE_URL=http://127.0.0.1:8484

# Whether agents may create projects via the API (true/false).
NOMOS_AGENTS_CAN_CREATE_PROJECTS=true

# Whether agents may set a project's working directory (true/false).
NOMOS_AGENTS_CAN_SET_WORKING_DIR=true
